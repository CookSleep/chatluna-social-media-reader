{
  "name": "chatluna-plugin-social-media-reader",
  "description": "通过工具按需读取哔哩哔哩视频与小红书笔记的正文、媒体和评论。",
  "version": "0.1.0",
  "homepage": "https://github.com/CookSleep/chatluna-social-media-reader",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CookSleep/chatluna-social-media-reader.git"
  },
  "bugs": {
    "url": "https://github.com/CookSleep/chatluna-social-media-reader/issues"
  },
  "contributors": [
    "CookSleep"
  ],
  "type": "module",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "GPL-3.0-only",
  "keywords": [
    "chatluna-plugin",
    "chatluna",
    "bilibili",
    "xiaohongshu",
    "social-media"
  ],
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@chatluna/storage-files": "workspace:*",
    "@cordisjs/plugin-database": "*",
    "@cordisjs/plugin-http": "*",
    "@chatluna/ai": "workspace:*",
    "@types/js-yaml": "*",
    "@chatluna/transform": "workspace:*"
  },
  "peerDependencies": {
    "@chatluna/schema": "*",
    "@chatluna/tool": "*",
    "cordis": "*",
    "@chatluna/message": "*",
    "@satorijs/core": "^4.6.1"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "cordis": {
    "category": "tool",
    "description": {
      "zh": "通过工具按需读取哔哩哔哩视频与小红书笔记的正文、媒体和评论。"
    },
    "service": {
      "required": [
        "tools",
        "model",
        "database",
        "timer",
        "transform"
      ],
      "optional": [
        "chatluna_storage",
        "ai"
      ]
    }
  }
}
