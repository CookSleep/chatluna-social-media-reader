{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "target": "ES2024",
    "module": "esnext",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "Bundler",
    "strict": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src"
  ]
}
